--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 97552c2c825c4cf4bb13d22c3ee83130, type: 3}
  m_Name: Opening
  m_EditorClassIdentifier: Odyssey.Runtime::Odyssey.Dialogue.DialogueSequence
  Lines:
  - Speaker: Narrator
    Text: Troy has fallen. After ten years of war, Odysseus and his crew sail for
      Ithaca - but the winds carry them to a wild, unknown island.
    SpeakerColor: {r: 0.75, g: 0.85, b: 1, a: 1}
  - Speaker: Odysseus
    Text: Ten years of war... and now only the sea stands between us and home.
    SpeakerColor: {r: 0.95, g: 0.8, b: 0.4, a: 1}
  - Speaker: Eurylochus
    Text: Captain, this island reeks of sheep and giants. The men are uneasy.
    SpeakerColor: {r: 0.7, g: 1, b: 0.7, a: 1}
  - Speaker: Odysseus
    Text: We need food and water. Stay close, and keep your spears ready.
    SpeakerColor: {r: 0.95, g: 0.8, b: 0.4, a: 1}
  - Speaker: Narrator
    Text: Fight across the island, honour the gods at their shrines, and reach the
      ship before the Cyclops finds you.
    SpeakerColor: {r: 0.75, g: 0.85, b: 1, a: 1}
  CharactersPerSecond: 45
